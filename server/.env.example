PORT=3000
NODE_ENV=development

# Credenciais fornecidas no painel da SyncPay (docs.syncpayments.com.br)
SYNCPAY_BASE_URL=https://api.syncpayments.com.br
SYNCPAY_CLIENT_ID=seu_client_id_aqui
SYNCPAY_CLIENT_SECRET=seu_client_secret_aqui

# URL pública (ngrok, Railway, VPS, etc.) onde a SyncPay enviará os Webhooks
SYNCPAY_WEBHOOK_URL=https://seu-dominio.com/api/webhook/syncpay

